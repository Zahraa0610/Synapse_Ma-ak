# Copy this file to backend/.env and fill in your values. Never commit .env.

# Secret used to sign login tokens (any long random text)
MAAK_SECRET=change-me-to-a-long-random-string

# Firebase: path to the service account key you downloaded (see README)
FIREBASE_CREDENTIALS=firebase-key.json

# WhatsApp codes: fill in ONE provider (see README). Leave both empty to print codes in the console.

# Option A - Meta WhatsApp Cloud API (free test number)
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
# Optional: an approved "authentication" template (needed to message people who have not written first)
META_WA_TEMPLATE=
META_WA_TEMPLATE_LANG=en_US

# Option B - Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID=
